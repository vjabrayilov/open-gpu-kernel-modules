/* Define the mdev type using your existing attribute group */
static struct mdev_type tempo_mdev_type = {
    .sysfs_name = "tempo-1g",  /* This is what appears in /sys/.../mdev_supported_types/ */
};

/* Create an array of pointers to mdev_types */
static struct mdev_type *tempo_mdev_types[] = {
    &tempo_mdev_type,
};
