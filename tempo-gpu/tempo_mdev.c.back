/* ──────────────────────────────────────────────────────────────────
 * VFIO Device Operations
 *
 * The VM communicates with its virtual GPU through these callbacks.
 * QEMU opens the mdev device and issues ioctl/read/write for:
 *   - Device capability discovery (GET_INFO, GET_REGION_INFO)
 *   - MMIO register access (read/write)
 *   - Interrupt configuration (SET_IRQS)
 * ────────────────────────────────────────────────────────────────── */

static int tempo_vfio_open_device(struct vfio_device *vdev)
{
    struct tempo_vm *vm = container_of(vdev, struct tempo_vm, vfio_dev);

    pr_info(TEMPO_DRIVER_NAME ": VM %d opened by QEMU (uuid %pUb)\n",
            vm->vm_id, &vm->uuid);
    return 0;
}

static void tempo_vfio_close_device(struct vfio_device *vdev)
{
    struct tempo_vm *vm = container_of(vdev, struct tempo_vm, vfio_dev);

    /* Deschedule this VM if it's currently running */
    if (g_tempo->active_vm_id == vm->vm_id) {
        unsigned long flags;

        spin_lock_irqsave(&g_tempo->sched_lock, flags);
        vm->state = VM_STATE_IDLE;
        g_tempo->active_vm_id = -1;
        spin_unlock_irqrestore(&g_tempo->sched_lock, flags);

        tempo_runlist_build_and_submit_empty(g_tempo);
    }

    pr_info(TEMPO_DRIVER_NAME ": VM %d closed\n", vm->vm_id);
}

static long tempo_vfio_ioctl(struct vfio_device *vdev, unsigned int cmd,
                             unsigned long arg)
{
    struct tempo_vm *vm = container_of(vdev, struct tempo_vm, vfio_dev);

    switch (cmd) {
    case VFIO_DEVICE_GET_INFO: {
        struct vfio_device_info info;

        if (copy_from_user(&info, (void __user *)arg, sizeof(info)))
            return -EFAULT;

        info.flags = VFIO_DEVICE_FLAGS_PCI | VFIO_DEVICE_FLAGS_RESET;
        info.num_regions = VFIO_PCI_NUM_REGIONS;
        info.num_irqs    = VFIO_PCI_NUM_IRQS;

        if (copy_to_user((void __user *)arg, &info, sizeof(info)))
            return -EFAULT;
        return 0;
    }

    case VFIO_DEVICE_GET_REGION_INFO: {
        struct vfio_region_info reg_info;

        if (copy_from_user(&reg_info, (void __user *)arg, sizeof(reg_info)))
            return -EFAULT;

        memset(&reg_info, 0, sizeof(reg_info));
        reg_info.argsz = sizeof(reg_info);

        switch (reg_info.index) {
        case VFIO_PCI_BAR0_REGION_INDEX:
            /* BAR0: MMIO registers — trapped and emulated */
            reg_info.flags = VFIO_REGION_INFO_FLAG_READ |
                             VFIO_REGION_INFO_FLAG_WRITE;
            reg_info.size  = g_tempo->bar0_size;
            break;
        case VFIO_PCI_BAR1_REGION_INDEX:
            /* BAR1: VRAM aperture — mapped to VM's partition */
            reg_info.flags = VFIO_REGION_INFO_FLAG_READ |
                             VFIO_REGION_INFO_FLAG_WRITE |
                             VFIO_REGION_INFO_FLAG_MMAP;
            reg_info.size  = vm->vram_size;
            break;
        default:
            reg_info.size = 0;
            break;
        }

        if (copy_to_user((void __user *)arg, &reg_info, sizeof(reg_info)))
            return -EFAULT;
        return 0;
    }

    case VFIO_DEVICE_GET_IRQ_INFO: {
        struct vfio_irq_info irq_info;

        if (copy_from_user(&irq_info, (void __user *)arg, sizeof(irq_info)))
            return -EFAULT;

        memset(&irq_info, 0, sizeof(irq_info));
        irq_info.argsz = sizeof(irq_info);

        if (irq_info.index == VFIO_PCI_MSI_IRQ_INDEX) {
            irq_info.flags = VFIO_IRQ_INFO_EVENTFD;
            irq_info.count = 1;
        }

        if (copy_to_user((void __user *)arg, &irq_info, sizeof(irq_info)))
            return -EFAULT;
        return 0;
    }

    case VFIO_DEVICE_RESET:
        pr_info(TEMPO_DRIVER_NAME ": VM %d reset\n", vm->vm_id);
        vm->state = VM_STATE_IDLE;
        return 0;

    default:
        return -ENOTTY;
    }
}

static ssize_t tempo_vfio_read(struct vfio_device *vdev, char __user *buf,
                               size_t count, loff_t *ppos)
{
    struct tempo_vm *vm = container_of(vdev, struct tempo_vm, vfio_dev);

    return tempo_mmio_read(g_tempo, vm, buf, count, ppos);
}

static ssize_t tempo_vfio_write(struct vfio_device *vdev,
                                const char __user *buf,
                                size_t count, loff_t *ppos)
{
    struct tempo_vm *vm = container_of(vdev, struct tempo_vm, vfio_dev);

    return tempo_mmio_write(g_tempo, vm, buf, count, ppos);
}

static const struct vfio_device_ops tempo_vfio_ops = {
    .name           = TEMPO_DRIVER_NAME,
    .open_device    = tempo_vfio_open_device,
    .close_device   = tempo_vfio_close_device,
    .ioctl          = tempo_vfio_ioctl,
    .read           = tempo_vfio_read,
    .write          = tempo_vfio_write,
};

/* ──────────────────────────────────────────────────────────────────
 * MDEV Lifecycle: probe / remove
 *
 * Called when a mediated device is created / destroyed via sysfs:
 *   echo <UUID> > .../mdev_supported_types/tempo-1g/create
 *   echo 1 > /sys/bus/mdev/devices/<UUID>/remove
 * ────────────────────────────────────────────────────────────────── */

static int tempo_mdev_probe(struct mdev_device *mdev)
{
    struct tempo_vm *vm;
    int vm_id, tsg_id, ret;
    unsigned long flags;

    /* 1. Allocate the VM struct using the VFIO managed allocator */
    /* This handles the internal initialization of vm->vfio_dev */
    vm = vfio_alloc_device(tempo_vm, vfio_dev, &mdev->dev, &tempo_vfio_ops);
    if (IS_ERR(vm)) {
        return PTR_ERR(vm);
    }

    /* 2. Lock-protected ID assignment */
    spin_lock_irqsave(&g_tempo->sched_lock, flags);
    if (g_tempo->num_vms >= TEMPO_MAX_VMS) {
        spin_unlock_irqrestore(&g_tempo->sched_lock, flags);
        pr_err(TEMPO_DRIVER_NAME ": max VMs reached (%d)\n", TEMPO_MAX_VMS);
        ret = -ENOSPC;
        goto err_put;
    }
    vm_id = g_tempo->num_vms++;
    spin_unlock_irqrestore(&g_tempo->sched_lock, flags);

    /* 3. Initialize custom fields */
    vm->vm_id    = vm_id;
    vm->active   = true;
    vm->state    = VM_STATE_IDLE;
    vm->priority = PRIO_STANDARD;
    guid_copy(&vm->uuid, &mdev->uuid);

    /* 4. Resource Allocation (TSG and VRAM) */
    tsg_id = tempo_tsg_alloc(g_tempo, vm_id);
    if (tsg_id < 0) {
        pr_err(TEMPO_DRIVER_NAME ": failed to allocate TSG for VM %d\n", vm_id);
        ret = tsg_id;
        goto err_dec_vms;
    }
    vm->tsg_id = tsg_id;
    tempo_vram_alloc_partition(g_tempo, vm);

    /* 5. Register with VFIO core */
    ret = vfio_register_group_dev(&vm->vfio_dev);
    if (ret) {
        pr_err(TEMPO_DRIVER_NAME ": vfio_register_group_dev failed: %d\n", ret);
        goto err_free_resources;
    }

    dev_set_drvdata(&mdev->dev, vm);

    /* Store the pointer in your global tracking if necessary,
       but remember VFIO now owns the primary lifecycle */
    g_tempo->vms[vm_id] = vm;

    pr_info(TEMPO_DRIVER_NAME ": created VM %d (TSG %u, VRAM %llu MB)\n",
            vm_id, vm->tsg_id, vm->vram_size >> 20);

    return 0;

err_free_resources:
    /* Add calls here to free TSG and VRAM if registration fails */
err_dec_vms:
    spin_lock_irqsave(&g_tempo->sched_lock, flags);
    g_tempo->num_vms--;
    spin_unlock_irqrestore(&g_tempo->sched_lock, flags);
err_put:
    /* This triggers the .release callback in your ops and calls kfree(vm) */
    vfio_put_device(&vm->vfio_dev);
    return ret;
}
